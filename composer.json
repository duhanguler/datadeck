{
  "name": "rowcraft/rowcraft",
  "description": "High-performance admin columns, zero-shift inline editor, AST bulk formula engine, and one-click rollback for WordPress & WooCommerce.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "woocommerce",
    "dataviews",
    "admin-columns",
    "bulk-edit",
    "inline-edit"
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "php-stubs/woocommerce-stubs": "^9.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "RowCraft\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RowCraft\\Tests\\": "tests/phpunit/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint:php": "phpcs",
    "lint:php:fix": "phpcbf",
    "stan": "phpstan analyse --memory-limit=512M",
    "test:unit": "phpunit --testsuite unit"
  }
}
